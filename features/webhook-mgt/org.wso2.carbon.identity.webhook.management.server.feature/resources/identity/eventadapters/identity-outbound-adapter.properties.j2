{% if outbound_adapters.websubhub.enabled is sameas true %}
adapter.websubhub.enabled={{outbound_adapters.websubhub.enabled}}
adapter.websubhub.baseUrl={{outbound_adapters.websubhub.base_url}}
adapter.websubhub.httpConnectionTimeout={{outbound_adapters.websubhub.httpConnectionTimeout}}
adapter.websubhub.httpReadTimeout={{outbound_adapters.websubhub.httpReadTimeout}}
adapter.websubhub.httpConnectionRequestTimeout={{outbound_adapters.websubhub.httpConnectionRequestTimeout}}
adapter.websubhub.connectionHandshakeTimeout={{outbound_adapters.websubhub.connectionHandshakeTimeout}}
adapter.websubhub.defaultMaxConnections={{outbound_adapters.websubhub.defaultMaxConnections}}
adapter.websubhub.defaultMaxConnectionsPerRoute={{outbound_adapters.websubhub.defaultMaxConnectionsPerRoute}}
adapter.websubhub.encryptionEnabled={{outbound_adapters.websubhub.encryptionEnabled}}
adapter.websubhub.encryptionKeyEndpointUrl={{outbound_adapters.websubhub.encryptionKeyEndpointUrl}}
adapter.websubhub.encryptionKeyCacheLifespan={{outbound_adapters.websubhub.encryptionKeyCacheLifespan}}
adapter.websubhub.topicDeletionDisabled={{outbound_adapters.websubhub.topicDeletionDisabled}}
adapter.websubhub.sslCertificateAlias={{outbound_adapters.websubhub.ssl_certificate_alias}}
adapter.websubhub.mtlsEnabled={{outbound_adapters.websubhub.mtlsEnabled}}
adapter.websubhub.maxRetries={{outbound_adapters.websubhub.maxRetries}}
adapter.websubhub.ioThreadCount={{outbound_adapters.websubhub.ioThreadCount}}
adapter.websubhub.executorCorePoolSize={{outbound_adapters.websubhub.executorCorePoolSize}}
adapter.websubhub.executorMaxPoolSize={{outbound_adapters.websubhub.executorMaxPoolSize}}
adapter.websubhub.executorQueueCapacity={{outbound_adapters.websubhub.executorQueueCapacity}}
adapter.websubhub.type={{outbound_adapters.websubhub.type}}
{% endif %}

{% if outbound_adapters.httppublisher.enabled is sameas true %}
adapter.httppublisher.enabled={{outbound_adapters.httppublisher.enabled}}
adapter.httppublisher.httpConnectionTimeout={{outbound_adapters.httppublisher.httpConnectionTimeout}}
adapter.httppublisher.httpReadTimeout={{outbound_adapters.httppublisher.httpReadTimeout}}
adapter.httppublisher.httpConnectionRequestTimeout={{outbound_adapters.httppublisher.httpConnectionRequestTimeout}}
adapter.httppublisher.connectionHandshakeTimeout={{outbound_adapters.httppublisher.connectionHandshakeTimeout}}
adapter.httppublisher.defaultMaxConnections={{outbound_adapters.httppublisher.defaultMaxConnections}}
adapter.httppublisher.defaultMaxConnectionsPerRoute={{outbound_adapters.httppublisher.defaultMaxConnectionsPerRoute}}
adapter.httppublisher.maxRetries={{outbound_adapters.httppublisher.maxRetries}}
adapter.httppublisher.ioThreadCount={{outbound_adapters.httppublisher.ioThreadCount}}
adapter.httppublisher.executorCorePoolSize={{outbound_adapters.httppublisher.executorCorePoolSize}}
adapter.httppublisher.executorMaxPoolSize={{outbound_adapters.httppublisher.executorMaxPoolSize}}
adapter.httppublisher.executorQueueCapacity={{outbound_adapters.httppublisher.executorQueueCapacity}}
adapter.httppublisher.type={{outbound_adapters.httppublisher.type}}
{% endif %}

{% if outbound_adapters.websubdirect.enabled is sameas true %}
adapter.websubdirect.enabled=true
adapter.websubdirect.type=PublisherSubscriber
# The adapter verifies the endpoint before it accepts a subscription, so a fully accepted webhook is ACTIVE.
adapter.websubdirect.verifiesSubscriptionSynchronously=true
adapter.websubdirect.hubUrl={{outbound_adapters.websubdirect.hubUrl}}
adapter.websubdirect.deliveryDataSource={{outbound_adapters.websubdirect.deliveryDataSource}}
{% if outbound_adapters.websubdirect.connectTimeout is defined %}
adapter.websubdirect.connectTimeout={{outbound_adapters.websubdirect.connectTimeout}}
{% endif %}
{% if outbound_adapters.websubdirect.readTimeout is defined %}
adapter.websubdirect.readTimeout={{outbound_adapters.websubdirect.readTimeout}}
{% endif %}
{% if outbound_adapters.websubdirect.connectionRequestTimeout is defined %}
adapter.websubdirect.connectionRequestTimeout={{outbound_adapters.websubdirect.connectionRequestTimeout}}
{% endif %}
{% if outbound_adapters.websubdirect.maxConnections is defined %}
adapter.websubdirect.maxConnections={{outbound_adapters.websubdirect.maxConnections}}
{% endif %}
{% if outbound_adapters.websubdirect.maxConnectionsPerRoute is defined %}
adapter.websubdirect.maxConnectionsPerRoute={{outbound_adapters.websubdirect.maxConnectionsPerRoute}}
{% endif %}
{% if outbound_adapters.websubdirect.ioThreadCount is defined %}
adapter.websubdirect.ioThreadCount={{outbound_adapters.websubdirect.ioThreadCount}}
{% endif %}
{% if outbound_adapters.websubdirect.maxInFlight is defined %}
adapter.websubdirect.maxInFlight={{outbound_adapters.websubdirect.maxInFlight}}
{% endif %}
{% if outbound_adapters.websubdirect.callbackThreads is defined %}
adapter.websubdirect.callbackThreads={{outbound_adapters.websubdirect.callbackThreads}}
{% endif %}
{% if outbound_adapters.websubdirect.callbackQueueCapacity is defined %}
adapter.websubdirect.callbackQueueCapacity={{outbound_adapters.websubdirect.callbackQueueCapacity}}
{% endif %}
{% if outbound_adapters.websubdirect.storeThreads is defined %}
adapter.websubdirect.storeThreads={{outbound_adapters.websubdirect.storeThreads}}
{% endif %}
{% if outbound_adapters.websubdirect.storeBufferMaxEntries is defined %}
adapter.websubdirect.storeBufferMaxEntries={{outbound_adapters.websubdirect.storeBufferMaxEntries}}
{% endif %}
{% if outbound_adapters.websubdirect.storeBufferMaxAgeSeconds is defined %}
adapter.websubdirect.storeBufferMaxAgeSeconds={{outbound_adapters.websubdirect.storeBufferMaxAgeSeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.firstRetryDelaySeconds is defined %}
adapter.websubdirect.firstRetryDelaySeconds={{outbound_adapters.websubdirect.firstRetryDelaySeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.retryWindowSeconds is defined %}
adapter.websubdirect.retryWindowSeconds={{outbound_adapters.websubdirect.retryWindowSeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.maxPendingPerWebhook is defined %}
adapter.websubdirect.maxPendingPerWebhook={{outbound_adapters.websubdirect.maxPendingPerWebhook}}
{% endif %}
{% if outbound_adapters.websubdirect.circuitFailureThreshold is defined %}
adapter.websubdirect.circuitFailureThreshold={{outbound_adapters.websubdirect.circuitFailureThreshold}}
{% endif %}
{% if outbound_adapters.websubdirect.circuitOpenSeconds is defined %}
adapter.websubdirect.circuitOpenSeconds={{outbound_adapters.websubdirect.circuitOpenSeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.verificationTimeout is defined %}
adapter.websubdirect.verificationTimeout={{outbound_adapters.websubdirect.verificationTimeout}}
{% endif %}
{% if outbound_adapters.websubdirect.leaseSeconds is defined %}
adapter.websubdirect.leaseSeconds={{outbound_adapters.websubdirect.leaseSeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.shutdownGraceSeconds is defined %}
adapter.websubdirect.shutdownGraceSeconds={{outbound_adapters.websubdirect.shutdownGraceSeconds}}
{% endif %}
{% if outbound_adapters.websubdirect.allowHttpEndpoints is defined %}
adapter.websubdirect.allowHttpEndpoints={{outbound_adapters.websubdirect.allowHttpEndpoints}}
{% endif %}
{% if outbound_adapters.websubdirect.allowPrivateAddresses is defined %}
adapter.websubdirect.allowPrivateAddresses={{outbound_adapters.websubdirect.allowPrivateAddresses}}
{% endif %}
{% if outbound_adapters.websubdirect.retryableStatusCodes is defined %}
adapter.websubdirect.retryableStatusCodes={{outbound_adapters.websubdirect.retryableStatusCodes}}
{% endif %}
{% if outbound_adapters.websubdirect.permanentStatusCodes is defined %}
adapter.websubdirect.permanentStatusCodes={{outbound_adapters.websubdirect.permanentStatusCodes}}
{% endif %}
{% endif %}

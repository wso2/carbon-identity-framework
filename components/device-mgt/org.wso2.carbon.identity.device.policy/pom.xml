<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>org.wso2.carbon.identity.framework</groupId>
        <artifactId>device-mgt</artifactId>
        <version>7.11.166-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>org.wso2.carbon.identity.device.policy</artifactId>
    <packaging>bundle</packaging>
    <name>WSO2 Carbon - Device Policy Component</name>
    <description>Device-specific policy evaluation, integrity enrichment, and adaptive auth JS function</description>
    <url>http://wso2.org</url>

    <dependencies>

        <!-- Client Attestation - for Play Integrity device verdict enrichment -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.client.attestation.mgt</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OSGi -->
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.osgi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.osgi.services</artifactId>
        </dependency>

        <!-- Commons logging -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>

        <!-- Commons lang - ArrayUtils -->
        <dependency>
            <groupId>commons-lang.wso2</groupId>
            <artifactId>commons-lang</artifactId>
        </dependency>

        <!-- Identity core -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.core</artifactId>
        </dependency>

        <!-- Central log management - diagnostic logging -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.central.log.mgt</artifactId>
        </dependency>

        <!-- Database utils - NamedJdbcTemplate for the device token replay store -->
        <dependency>
            <groupId>org.wso2.carbon.utils</groupId>
            <artifactId>org.wso2.carbon.database.utils</artifactId>
        </dependency>

        <!-- Policy management - PolicyManagementService, Policy, PolicyRule, exceptions -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.policy.management</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Policy evaluation - PolicyEvaluationService -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.policy.evaluation</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Device management - DeviceManagementService, RegisteredDevice -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.device.mgt</artifactId>
        </dependency>

        <!-- Rule management -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.rule.management</artifactId>
        </dependency>

        <!-- Rule evaluation -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.rule.evaluation</artifactId>
        </dependency>

        <!-- Authentication framework - JsFunctionRegistry -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.authentication.framework</artifactId>
        </dependency>

        <!-- GraalVM SDK - HostAccess annotation for JS function exposure -->
        <dependency>
            <groupId>org.wso2.orbit.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
        </dependency>

        <!-- Nimbus JOSE+JWT - JWT parsing and signature verification -->
        <dependency>
            <groupId>org.wso2.orbit.com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson - JSON parsing for device-fields.json -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.testutil</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Private-Package>
                            org.wso2.carbon.identity.device.policy.internal.*
                        </Private-Package>
                        <Export-Package>
                            !org.wso2.carbon.identity.device.policy.internal.*,
                            org.wso2.carbon.identity.device.policy.api.*;
                            version="${carbon.identity.package.export.version}"
                        </Export-Package>
                        <Import-Package>
                            org.wso2.carbon.utils; version="${carbon.kernel.package.import.version.range}",
                            org.wso2.carbon.database.utils.jdbc;
                            version="${org.wso2.carbon.database.utils.version.range}",
                            org.wso2.carbon.database.utils.jdbc.exceptions;
                            version="${org.wso2.carbon.database.utils.version.range}",
                            org.wso2.carbon.identity.core.util;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.central.log.mgt.utils;
                            version="${carbon.identity.package.import.version.range}",
                            org.apache.commons.logging; version="${import.package.version.commons.logging}",
                            org.apache.commons.lang; version="${commons-lang.wso2.osgi.version.range}",
                            org.osgi.framework; version="${osgi.framework.imp.pkg.version.range}",
                            org.osgi.service.component; version="${osgi.service.component.imp.pkg.version.range}",
                            org.osgi.service.component.annotations;
                            version="${osgi.service.component.imp.pkg.version.range}",
                            org.wso2.carbon.identity.policy.management.api.exception;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.policy.management.api.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.policy.management.api.service;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.policy.evaluation.api.service;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.policy.evaluation.api.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.policy.evaluation.api.exception;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.device.mgt.api.exception;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.device.mgt.api.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.device.mgt.api.service;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.rule.management.api.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.rule.evaluation.api.exception;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.rule.evaluation.api.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.rule.evaluation.api.provider;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.application.authentication.framework;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.application.authentication.framework.config.model.graph.js.base;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.application.authentication.framework.device;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.application.authentication.framework.context;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.application.authentication.framework.util;
                            version="${carbon.identity.package.import.version.range}",
                            org.graalvm.polyglot; version="${graalvm.version.range}",
                            com.nimbusds.jose.*; version="${nimbusds.osgi.version.range}",
                            com.nimbusds.jwt.*; version="${nimbusds.osgi.version.range}",
                            org.wso2.carbon.identity.client.attestation.mgt.services;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.client.attestation.mgt.model;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.client.attestation.mgt.exceptions;
                            version="${carbon.identity.package.import.version.range}",
                            org.wso2.carbon.identity.client.attestation.mgt.utils;
                            version="${carbon.identity.package.import.version.range}",
                            javax.servlet.http,
                            com.fasterxml.jackson.core.type,
                            com.fasterxml.jackson.databind
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>../../../spotbugs-exclude.xml</excludeFilterFile>
                    <effort>Max</effort>
                    <threshold>High</threshold>
                    <xmlOutput>true</xmlOutput>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <org.apache.commons.logging.Log>org.apache.commons.logging.impl.NoOpLog</org.apache.commons.logging.Log>
                    </systemPropertyVariables>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report-integration</id>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule implementation="org.jacoco.maven.RuleConfiguration">
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit implementation="org.jacoco.report.check.Limit">
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit implementation="org.jacoco.report.check.Limit">
                                            <counter>COMPLEXITY</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
